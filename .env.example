# LLM Provider Configuration
# Choose one provider: "claude" (recommended), "gemini" (free tier), or "openai"

# === Claude/Anthropic API (RECOMMENDED) ===
# Fast, reliable, no SSL issues
# Get your API key: https://console.anthropic.com/
# IMPORTANT: Revoke and regenerate any keys you've previously shared!
ANTHROPIC_API_KEY=your-new-anthropic-key-here

# === OpenAI API (Required for embeddings when using Claude) ===
# Also required for OpenAI provider
# Get your API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here

# === Google Gemini API (Alternative - Free tier available) ===
# Get your FREE API key: https://makersuite.google.com/app/apikey
# GOOGLE_API_KEY=your_google_api_key_here

# === Select which provider to use ===
LLM_PROVIDER=claude

# === Security Note ===
# NEVER share your API keys publicly!
# This .env file is gitignored and will not be committed.
