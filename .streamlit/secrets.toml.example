# Streamlit Secrets Configuration Example
#
# When deploying to Streamlit Cloud:
# 1. Go to your app settings
# 2. Click on "Secrets" in the left sidebar
# 3. Copy the content below and paste it there
# 4. Replace "your-api-key-here" with your actual OpenAI API key
#
# For local development:
# 1. Copy this file to .streamlit/secrets.toml
# 2. Add your actual API key
# 3. Make sure .streamlit/secrets.toml is in .gitignore (it already is)

OPENAI_API_KEY = "your-api-key-here"
